# Copy to backend/.env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Backend only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres connection string (Project Settings > Database)
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Channels ---
# Fernet key for encrypting channel tokens in store_channels.credentials.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_SECRET=
# Public URL for webhooks (e.g. ngrok / cloudflared tunnel in dev)
PUBLIC_BASE_URL=http://localhost:8000

# --- Frontend (frontend/.env) ---
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://localhost:8000
