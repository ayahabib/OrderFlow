# Copy to backend/.env and fill in real values. Never commit .env.

# --- Supabase ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
# Backend only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string (Supabase dashboard > Connect).
# Use the "Session pooler" string (port 5432): the direct db.<ref>.supabase.co host
# is IPv6-only on the free tier and fails on most IPv4 networks.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- OpenAI (paid per use; unit tests use a mock, never the real API) ---
OPENAI_API_KEY=
# Chat model for extraction / intent / RAG answers
OPENAI_MODEL=
# Requested at dimensions=768 to match knowledge_base.embedding vector(768)
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional: another OpenAI-compatible provider for the chat model only (embeddings stay on OpenAI).
# e.g. LLM_BASE_URL=https://openrouter.ai/api/v1 with an OpenRouter key, and OPENAI_MODEL set to that provider's model id.
LLM_BASE_URL=
LLM_API_KEY=
# Seconds per chat-model call before it counts as failed (retry once, then escalate). Free models are slower.
LLM_TIMEOUT_SECONDS=20

# --- Channels ---
# Fernet key for encrypting channel tokens in store_channels.credentials.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHANNEL_ENCRYPTION_KEY=
# Master secret for customer-bot webhooks; each channel gets its own token derived from it.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Signs web chat simulator session tokens.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_CHAT_SECRET=
# WhatsApp Cloud API (official, task 5.1). One Meta app for the platform:
# App Secret from Meta: App settings > Basic (verifies every webhook call).
WHATSAPP_APP_SECRET=
# Any random string; paste the same value in Meta: WhatsApp > Configuration > Verify token.
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Permanent token of a System User in the platform's Meta Business (task 5.4): Business settings >
# Users > System users > Generate token (permissions whatsapp_business_messaging + whatsapp_business_management).
# Numbers the admin connects send with it. Empty = admin connect is off.
WHATSAPP_SYSTEM_USER_TOKEN=
# Seconds the bot waits after the latest message so split-up messages are answered together. 0 = no wait.
CHAT_DEBOUNCE_SECONDS=2.5
# Simulator limits (it is public; each message costs an LLM call). 0 = no limit.
WEB_CHAT_MAX_MESSAGES_PER_SESSION=30
WEB_CHAT_MAX_MESSAGES_PER_IP_HOUR=60
WEB_CHAT_MAX_SESSIONS_PER_IP_HOUR=5
WEB_CHAT_MAX_MESSAGES_PER_STORE_DAY=500
# Owner notifications: token of ONE platform bot from @BotFather (not a store's own bot).
# The owner links their Telegram from Settings; escalation alerts are sent through it.
TELEGRAM_NOTIFY_BOT_TOKEN=
# Dashboard address used in alert links
DASHBOARD_URL=http://localhost:5173
# Public HTTPS URL for webhooks. In dev: `ngrok http 8000`, paste the https URL here, restart the backend,
# then connect (or reconnect) the store's Telegram bot from Settings. A new ngrok URL means reconnecting.
PUBLIC_BASE_URL=http://localhost:8000
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Frontend (frontend/.env) ---
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_BASE_URL=http://localhost:8000
